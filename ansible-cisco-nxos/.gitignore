# Environment files containing credentials
.env
*.env
.env.local

# Ansible retry files (disabled by default but included for safety)
*.retry

# Vault password files
.vault_password
vault_password
vault_pass.txt
*vault-password*
*vault-pass*

# Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Generated output files (keep .gitkeep)
output/*.yml
output/*.yaml
output/*.txt
output/*/
!output/.gitkeep

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# IDE metadata
.idea/
.vscode/
*.iml
*.sublime-project
*.sublime-workspace

# Editor swap files
.DS_Store
Thumbs.db

# Ansible log file
ansible.log

# Local overrides
local.yml
overrides.yml
